# URL do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Preferível: chave pública (publishable). A chave anon antiga também é aceite.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Chave secreta apenas para rotas do servidor. Nunca usar NEXT_PUBLIC_ nem expor no browser.
SUPABASE_SECRET_KEY=sb_secret_your-server-secret-key
